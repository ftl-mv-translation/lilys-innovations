#: src-en/data/text_tooltips.xml.append:23
msgid ""
"data/text_tooltips.xml.append$//text[@name=\"tooltip_lily_infusion_bay_disabled\"]"
msgstr "Désactivé. Les infusions ne peuvent pas être activées."

#: src-en/data/text_tooltips.xml.append:24
msgid ""
"data/text_tooltips.xml.append$//text[@name=\"tooltip_lily_infusion_bay_level\"]"
